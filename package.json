{
  "name": "lannpya-unified-local-workspace",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "start": "node scripts/start_local.cjs",
    "build": "node scripts/build_frontend.cjs",
    "test:frontend": "node --test frontend/tests/workflow-domain.test.js frontend/tests/order-parser.test.js frontend/tests/functional-app.test.js frontend/tests/api-model.test.mjs backend/tools/api_workspace/tests/api-workspace.test.mjs frontend/tests/local-api.test.mjs frontend/tests/live-store.test.mjs",
    "test:integration": "node --test backend/tools/api_workspace/tests/integration-http.test.mjs",
    "test:dashboard": "node --test docs/examples/lannpya-client.test.mjs tools/backend-test-dashboard/dashboard.test.cjs tools/backend-test-dashboard/dashboard-http.test.cjs",
    "test:parser": "npm --prefix order-parser test",
    "test:browser": "playwright test",
    "verify:mtt-restart": "node scripts/verify_mtt_restart.cjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
