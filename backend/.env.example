# Default local mock; prepared external adapters require a separate explicit opt-in.
LANNPYA_AI_PROVIDER=mock
LANNPYA_AI_EXTERNAL_REQUESTS_ENABLED=false
# Future activation requires explicit approval, a selected model and server-only credentials:
# LANNPYA_AI_MODEL=operator-selected-model
# LANNPYA_AI_API_KEY=provide-via-server-secret-store
# json_http only: LANNPYA_AI_ENDPOINT=https://your-approved-inference-service/extract
# hybrid is rules-first with optional sanitized AI enrichment. rules skips AI entirely.
# mock is the legacy fixed demo, unrelated to the hybrid mock enrichment adapter.
LANNPYA_PARSER_MODE=hybrid
LANNPYA_AI_TIMEOUT_SECONDS=3.0
LANNPYA_AI_MAX_INPUT_CHARS=2000
# JSON array of exact frontend origins (scheme + host + port).
LANNPYA_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500"]
# Order management is opt-in, loopback-only, and disabled in production regardless of flags.
LANNPYA_ENVIRONMENT=local
LANNPYA_ORDER_MANAGEMENT_ENABLED=false
LANNPYA_DATABASE_URL=sqlite+pysqlite:///./data/lannpya_dev.sqlite3
# init_local.py generates private credentials in ignored .env; no shared example secret.
# LANNPYA_DEV_ACCESS_TOKEN=
# LANNPYA_DEV_ACTOR_ID=
# Database backend configuration: SQLite (default local) or Supabase PostgreSQL
# Both DATABASE_URL and LANNPYA_DATABASE_URL are supported.
# Supabase Connection Pooler / Transaction mode (recommended for serverless & cloud, port 6543):
# LANNPYA_DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Supabase Direct Connection (port 5432):
# LANNPYA_DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# Standard postgres:// schemes are automatically normalized to postgresql+psycopg.
# Buyer card policies. Defaults do not enable public/production order management.
LANNPYA_BUYER_LINK_HOURS=72
LANNPYA_BUYER_SESSION_MINUTES=15
# Optional trusted frontend base; never built from the request Host header.
# LANNPYA_BUYER_FRONTEND_BASE_URL=http://localhost:5173
# Google Maps browser key (Maps JavaScript API + Places API). Restrict it by HTTP referrer.
# LANNPYA_GOOGLE_MAPS_BROWSER_KEY=
# Optional only. Leave unset for local Leaflet with opt-in OpenStreetMap tiles.
# This browser key is public by design; never put AI keys or dev access tokens here.
LANNPYA_BUYER_REQUEST_LIMIT_PER_MINUTE=60
LANNPYA_BUYER_VERIFY_LIMIT_PER_MINUTE=10
LANNPYA_BUYER_RESCHEDULING_ENABLED=false
LANNPYA_BUYER_LEAVE_WITH_SECURITY_ENABLED=false
LANNPYA_BUYER_CUTOFF_HOUR=15
LANNPYA_BUYER_MIN_NOTICE_MINUTES=120
LANNPYA_BUYER_MAX_SCHEDULE_DAYS=7
# Optional indicative courier fee, not a quote, charge or payment collection.
# LANNPYA_BUYER_CROSS_TOWNSHIP_FEE_MMK=0
# Rider operational policy; uses the same local-only access boundary.
LANNPYA_RIDER_MAX_ACTIVE_ASSIGNMENTS=100
LANNPYA_RIDER_REQUIRE_COD_CONFIRMATION=true

# Road routing is separate from AI. Offline requests require explicit simulation acknowledgement.
LANNPYA_ROUTING_PROVIDER=offline
LANNPYA_ROUTING_EXTERNAL_REQUESTS_ENABLED=false
LANNPYA_GOOGLE_ROUTES_API_KEY=
LANNPYA_ORS_API_KEY=
LANNPYA_ROUTING_TWO_WHEELER_ENABLED=false
LANNPYA_ROUTING_REQUEST_TIMEOUT_SECONDS=10
LANNPYA_ROUTING_MAX_STOPS=25
LANNPYA_ROUTING_REQUESTS_PER_MINUTE=10
LANNPYA_ROUTING_PLAN_TTL_MINUTES=15
# Separate authorization and a bounded budget required for single-order Google estimates.
# Keep the optimizer on offline: Demo Key estimates never request a matrix.
LANNPYA_GOOGLE_DEMO_ENABLED=false
LANNPYA_GOOGLE_DEMO_MAX_REQUESTS=0
# integrated_workspace ignores .env files: set these in the launcher process environment.

# Independent CLI evaluation safeguards. Defaults permit ZERO external evaluation calls.
# The evaluation CLI ignores .env: configure approved process variables only.
LANNPYA_ROUTING_EVAL_LIVE_ENABLED=false
LANNPYA_ROUTING_EVAL_PROVIDER=google
LANNPYA_ROUTING_EVAL_MAX_REQUESTS=0
LANNPYA_ROUTING_EVAL_MAX_MATRIX_ELEMENTS=0
LANNPYA_ROUTING_EVAL_MAX_STOPS=6
LANNPYA_ROUTING_EVAL_REQUEST_TIMEOUT_SECONDS=10
LANNPYA_ROUTING_EVAL_EVALUATION_TIMEOUT_SECONDS=60
LANNPYA_ROUTING_EVAL_MAX_ESTIMATED_COST=0
LANNPYA_ROUTING_EVAL_PRICING_MAX_AGE_DAYS=30
# Reviewed per-mode pricing is mandatory for live evaluation; no prices assumed here.
